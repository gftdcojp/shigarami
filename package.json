{
  "name": "shigrami",
  "version": "0.1.0",
  "description": "Dependency Compatibility Database - Context7-like system for tracking package compatibility issues",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "ci:test": "npm run build && npm run test",
    "export": "node dist/index.js export",
    "store:put": "node dist/index.js store:put",
    "store:get": "node dist/index.js store:get",
    "store:list": "node dist/index.js store:list",
    "store:stats": "node dist/index.js store:stats",
    "store:export": "node dist/index.js store:export"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/junkawasaki/shigrami.git"
  },
  "keywords": [
    "dependencies",
    "compatibility",
    "npm",
    "yarn",
    "pnpm",
    "peer-dependencies",
    "conflict-resolution",
    "mcp",
    "context7"
  ],
  "author": "Jun Kawasaki",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "commander": "^14.0.1",
    "express": "^4.18.0",
    "table": "^6.9.0",
    "zod": "^3.22.0"
  }
}
